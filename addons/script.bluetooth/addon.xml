<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.bluetooth" name="Bluetooth" version="1.0.0" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="main.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Pair Bluetooth controllers and headphones</summary>
    <description lang="en_GB">Scans for Bluetooth devices, pairs them and keeps them trusted so they reconnect on their own. Driven from the sofa with a controller or remote; no terminal needed.</description>
    <platform>linux</platform>
    <license>MIT</license>
  </extension>
</addon>
