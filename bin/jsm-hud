#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""On-screen controls reference and live tuning for JoyShockMapper.

Runs alongside a game, started by pcgame_launch.py. Two jobs:

  * a toast when JSM loads a different config, so switching to the desktop
    layer and back is visible rather than something you infer from behaviour
  * an overlay, opened by a button combo, showing what every button currently
    does and letting you change the handful of settings worth changing mid
    game -- gyro sensitivity, stick speed, calibration

Three things make this possible, each established by testing rather than
assumption:

  * the controller stays readable over evdev while JSM holds it via hidraw,
    so the trigger combo is detected here and is NOT limited to the two
    buttons a JSM binding allows
  * an override-redirect, keep-above, RGBA window paints over these games --
    verified over fullscreen Kodi, Quake III and Warcraft III
  * JSM takes console commands on stdin, so the launcher hands us a fifo and
    tuning applies instantly with nothing written to disk

Config files are the same ones the Kodi editor reads and writes, so the two
front ends stay in sync with no extra machinery.
"""

import argparse
import os
import re
import select
import shutil
import struct
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/home/retro/.local/lib/jsmconfig")
import jsmconfig as J

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

# ---------------------------------------------------------------------------
# controller
# ---------------------------------------------------------------------------

EVENT_SIZE = 24
EVENT_FMT = "llHHi"
EV_KEY = 0x01
EV_ABS = 0x03

# The d-pad is not buttons: hid-nintendo reports it as a hat, two axes each
# going -1 / 0 / +1. Navigation has to read those as well as EV_KEY, or
# nothing on the d-pad ever registers.
ABS_HAT0X = 0x10
ABS_HAT0Y = 0x11
HAT_NAMES = {
    (ABS_HAT0X, -1): "LEFT", (ABS_HAT0X, 1): "RIGHT",
    (ABS_HAT0Y, -1): "UP", (ABS_HAT0Y, 1): "DOWN",
}

# evdev codes for the pad, as hid-nintendo reports them.
BTN = {
    "S": 0x130, "E": 0x131, "W": 0x134, "N": 0x133,
    "L": 0x136, "R": 0x137, "ZL": 0x138, "ZR": 0x139,
    "-": 0x13a, "+": 0x13b, "HOME": 0x13c, "L3": 0x13d, "R3": 0x13e,
}
NAME_BY_CODE = dict((v, k) for k, v in BTN.items())

DEFAULT_COMBO = ["+", "L", "R"]


BTN_SOUTH = 0x130


def _declares_gamepad_buttons(block):
    """True if the device's KEY bitmap includes BTN_SOUTH.

    /proc/bus/input/devices prints the bitmap as 64-bit hex words, most
    significant FIRST, so word i of the bitmap is at position len-1-i.
    Checking a real gamepad button is what separates a pad from a mouse --
    the previous test was "has ABS and KEY", which a Logitech mouse also
    satisfies, so the HUD sat listening to the mouse and no combo ever fired.
    """
    match = re.search(r"B: KEY=(.*)", block)
    if not match:
        return False
    try:
        words = [int(w, 16) for w in match.group(1).split()]
    except ValueError:
        return False
    index, bit = divmod(BTN_SOUTH, 64)
    if index >= len(words):
        return False
    return bool(words[len(words) - 1 - index] >> bit & 1)


def find_pad_nodes():
    """Every gamepad worth listening to, physical ones first.

    Only JoyShockMapper's own devices are excluded: those carry the keyboard
    and mouse output JSM synthesises from the pad, so reading them back would
    feed our own output in as input. Sunshine's virtual pad is a real input
    source -- over Moonlight it is the only one -- and must not be skipped.
    """
    physical, virtual = [], []
    try:
        with open("/proc/bus/input/devices") as handle:
            blocks = handle.read().split("\n\n")
    except OSError:
        return []
    for block in blocks:
        name = re.search(r'N: Name="(.*)"', block)
        name = name.group(1) if name else ""
        if name.startswith("JoyShockMapper"):
            continue
        if "(IMU)" in name:
            continue                      # motion axes, no buttons
        if not _declares_gamepad_buttons(block):
            continue
        handlers = re.search(r"H: Handlers=(.*)", block)
        if not handlers:
            continue
        node = None
        for handler in handlers.group(1).split():
            if handler.startswith("event"):
                node = "/dev/input/" + handler
                break
        if not node:
            continue
        sysfs = re.search(r"S: Sysfs=(.*)", block)
        is_virtual = bool(sysfs) and \
            sysfs.group(1).strip().startswith("/devices/virtual/")
        (virtual if is_virtual else physical).append((name, node))
    return physical + virtual


def find_pad_event_node(prefer=None):
    """The single best pad, kept for callers that want just one."""
    nodes = find_pad_nodes()
    if not nodes:
        return None
    if prefer:
        for name, node in nodes:
            if prefer.lower() in name.lower():
                return node
    return nodes[0][1]


def list_input_devices():
    """Debug aid: what the HUD can see and which one it would use."""
    try:
        blocks = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        return
    chosen = set(node for _n, node in find_pad_nodes())
    for block in blocks:
        name = re.search(r'N: Name="(.*)"', block)
        if not name:
            continue
        handlers = re.search(r"H: Handlers=(.*)", block)
        sysfs = re.search(r"S: Sysfs=(.*)", block)
        node = ""
        for h in (handlers.group(1).split() if handlers else []):
            if h.startswith("event"):
                node = "/dev/input/" + h
                break
        print("%-38s %-18s pad=%-5s virtual=%-5s %s"
              % (name.group(1)[:38], node,
                 _declares_gamepad_buttons(block),
                 (sysfs.group(1).strip().startswith("/devices/virtual/")
                  if sysfs else False),
                 "<-- WATCHED" if node and node in chosen else ""))


class PadWatcher(threading.Thread):
    """Watches the pad for the trigger combo and, while the overlay is up,
    for navigation. Reads evdev directly, so it works regardless of which
    window has X focus."""

    daemon = True

    def __init__(self, combo, on_trigger, on_nav, prefer=None):
        super().__init__()
        self.prefer = prefer
        self.combo = set(BTN[b] for b in combo if b in BTN)
        self.on_trigger = on_trigger
        self.on_nav = on_nav
        self.held = set()
        self.navigating = False
        self._fired = False
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    RESCAN = 3.0                     # seconds between device sweeps

    def run(self):
        watched = {}                 # fd -> [node, held set]
        next_scan = 0.0
        while not self._stop.is_set():
            now = time.time()
            if now >= next_scan:
                next_scan = now + self.RESCAN
                self._sync(watched)
            if not watched:
                time.sleep(0.5)
                continue
            ready, _, _ = select.select(list(watched), [], [], 0.5)
            for fd in ready:
                entry = watched.get(fd)
                if entry is None:
                    continue
                try:
                    data = os.read(fd, EVENT_SIZE)
                except OSError:
                    self._drop(watched, fd)      # pad went away mid-read
                    continue
                if len(data) < EVENT_SIZE:
                    continue
                self._handle(entry, data)

    def _sync(self, watched):
        """Open pads that have appeared, drop ones that have gone."""
        wanted = dict((node, name) for name, node in find_pad_nodes())
        for fd in [fd for fd, e in watched.items() if e[0] not in wanted]:
            self._drop(watched, fd)
        open_nodes = set(e[0] for e in watched.values())
        for node in wanted:
            if node in open_nodes:
                continue
            try:
                fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue                 # permissions or a race; try next sweep
            watched[fd] = [node, set()]

    def _drop(self, watched, fd):
        watched.pop(fd, None)
        try:
            os.close(fd)
        except OSError:
            pass

    def _handle(self, entry, data):
        _s, _us, etype, code, value = struct.unpack(EVENT_FMT, data)
        held = entry[1]

        if etype == EV_ABS and code in (ABS_HAT0X, ABS_HAT0Y):
            # Only the push matters, not the return to centre.
            name = HAT_NAMES.get((code, 1 if value > 0 else
                                  -1 if value < 0 else 0))
            if name and self.navigating:
                GLib.idle_add(self.on_nav, name)
            return

        if etype != EV_KEY:
            return
        if value:
            held.add(code)
        else:
            held.discard(code)

        # Per device: the combo has to be pressed on one pad, not assembled
        # from presses spread across two.
        if self.combo and self.combo.issubset(held):
            if not self._fired:
                self._fired = True
                GLib.idle_add(self.on_trigger)
        elif not self.combo.issubset(held):
            self._fired = False

        if self.navigating and value == 1:
            button = NAME_BY_CODE.get(code)
            if button:
                GLib.idle_add(self.on_nav, button)


# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

LABELS = [
    ("N", "X"), ("E", "A"), ("S", "B"), ("W", "Y"),
    ("L", "L"), ("R", "R"), ("ZL", "ZL"), ("ZR", "ZR"),
    ("UP", "D-up"), ("DOWN", "D-down"), ("LEFT", "D-left"), ("RIGHT", "D-right"),
    ("L3", "L3"), ("R3", "R3"), ("-", "Minus"), ("+", "Plus"),
]
LABEL_OF = dict(LABELS)


def read_config(path):
    """Flat {key: value} for display, resolved through the include chain."""
    cfg = J.Config(path)
    values = {}
    for key in [k for k, _ in LABELS] + [k for k, _l, _t, _c in
                                         sum((g[1] for g in J.SETTING_GROUPS), [])]:
        value, _origin = cfg.effective(key)
        if value is not None:
            values[key] = value
    for key, value, _inherited in cfg.effective_bindings("+"):
        values[key] = value
    return values


def pretty(value):
    """Turn a JSM action into something readable at a glance."""
    if not value:
        return "-"
    if value.startswith("hold:") or " + hold:" in value:
        return value
    value = value.strip().strip('"')
    if value.endswith(".txt"):
        return "layer: " + os.path.basename(value)[:-4]
    parts = split_style(value)
    if parts is not None and (parts[0] or parts[2]):
        prefix, key, suffix = parts
        shown = pretty(key)
        if prefix:
            shown = "%s %s" % (PREFIX_WORDS.get(prefix, prefix), shown)
        if suffix:
            shown = "%s (%s)" % (shown, SUFFIX_WORDS.get(suffix, suffix))
        return shown
    return {"LMOUSE": "fire", "RMOUSE": "alt fire", "MMOUSE": "middle click",
            "SCROLLUP": "scroll up", "SCROLLDOWN": "scroll down",
            "LSHIFT": "shift", "LCONTROL": "ctrl", "LALT": "alt",
            "SPACE": "space", "ESC": "esc", "ENTER": "enter",
            "CALIBRATE": "calibrate gyro", "NONE": "-"}.get(value, value.lower())


def button_label(key):
    """Readable name for anything bindable, physical button or stick
    direction. The grid's own labels win, then the shared table."""
    return LABEL_OF.get(key) or J.BUTTON_LABELS.get(key, key)


def mode_label(mode):
    return (mode or "").strip().lower().replace("_", " ") or "not set"


STICK_MODE_SETTING = {"L": "LEFT_STICK_MODE", "R": "RIGHT_STICK_MODE"}
STICK_SIDE_NAME = {"L": "Left stick", "R": "Right stick"}
STICK_DIRECTIONS = (("Up", "UP"), ("Down", "DOWN"),
                    ("Left", "LEFT"), ("Right", "RIGHT"))

# (label, stick mode, what the four directions become). None leaves the
# directions alone, because in a mouse mode JSM ignores them anyway and
