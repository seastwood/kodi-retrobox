# ---------------------------------------------------------------------------
# JSM
# ---------------------------------------------------------------------------

class Jsm(object):
    """The command channel and the log the launcher set up for us."""

    LOADING = re.compile(r"Loading commands from file\s+(.*?)\s*$")

    def __init__(self, fifo, log, on_layer):
        self.fifo = fifo
        self.log = log
        self.on_layer = on_layer
        self._stop = threading.Event()

    def send(self, command):
        try:
            fd = os.open(self.fifo, os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            return False
        try:
            os.write(fd, (command + "\n").encode())
            return True
        except OSError:
            return False
        finally:
            os.close(fd)

    def watch(self):
        thread = threading.Thread(target=self._tail, daemon=True)
        thread.start()

    def _tail(self):
        """Follow JSM's stdout for config loads. Opened lazily and reopened if
        it is replaced, so starting before JSM does is fine."""
        handle = None
        inode = None
        while not self._stop.is_set():
            try:
                stat = os.stat(self.log)
                if handle is None or stat.st_ino != inode:
                    if handle:
                        handle.close()
                    handle = open(self.log, "r", errors="replace")
                    handle.seek(0, os.SEEK_END)
                    inode = stat.st_ino
            except OSError:
                time.sleep(1)
                continue
            line = handle.readline()
            if not line:
                time.sleep(0.3)
                continue
            clean = re.sub(r"\x1b\[[0-9;]*m", "", line).strip()
            match = self.LOADING.search(clean)
            if match:
                GLib.idle_add(self.on_layer, match.group(1))


# ---------------------------------------------------------------------------
# windows
# ---------------------------------------------------------------------------

DESIGN_WIDTH = 1920.0            # the width every size below is written for


def build_css(scale):
    def pt(size):
        return max(7, int(round(size * scale)))

    def px(size):
        return max(1, int(round(size * scale)))

    return ("""
#dim   { background-color: rgba(0, 0, 0, 0.78); }
#toast {
    background-color: rgba(18, 20, 26, 0.72);
    border: %(b2)dpx solid rgba(120, 200, 255, 0.55);
    border-radius: %(r14)dpx;
    padding: %(p14)dpx %(p28)dpx;
}
#toasttitle { color: #7fd4ff; font-size: %(f22)dpt; font-weight: bold; }
#toastsub   { color: #b9c2cc; font-size: %(f14)dpt; }
#panel {
    background-color: rgba(14, 16, 22, 0.97);
    border: %(b3)dpx solid rgba(120, 200, 255, 0.9);
    border-radius: %(r22)dpx;
    padding: %(p34)dpx %(p56)dpx;
}
#title    { color: #7fd4ff; font-size: %(f34)dpt; font-weight: bold; }
#sub      { color: #b9c2cc; font-size: %(f20)dpt; }
#head     { color: #7fd4ff; font-size: %(f30)dpt; font-weight: bold; }
#section  { color: #6d7885; font-size: %(f16)dpt; font-weight: bold; }
#btn      { color: #7fd4ff; font-size: %(f21)dpt; font-weight: bold; }
#btnsel   { color: #0d1016; font-size: %(f21)dpt; font-weight: bold; }
#act      { color: #e6e6e6; font-size: %(f21)dpt; }
#actsel   { color: #0d1016; font-size: %(f21)dpt; }
#row      { color: #d8dee6; font-size: %(f26)dpt; padding: %(p8)dpx %(p20)dpx; }
/* Same size, same weight, same padding as #row -- only the colours differ,
   so nothing reflows when the cursor lands on a row. */
#rowsel   { color: #0d1016; background-color: #7fd4ff; font-size: %(f26)dpt;
            border-radius: %(r10)dpx; padding: %(p8)dpx %(p20)dpx; }
#key      { color: #d8dee6; font-size: %(f17)dpt;
            background-color: rgba(40, 46, 58, 0.95);
            border: %(b2)dpx solid rgba(90, 100, 116, 0.9);
            border-radius: %(r10)dpx; padding: %(p8)dpx %(p8)dpx; }
/* The binding the button already has. Same metrics as #key -- only the
   colours differ -- so marking it cannot reflow the keyboard. */
#keycur   { color: #ffd479; font-size: %(f17)dpt;
            background-color: rgba(40, 46, 58, 0.95);
            border: %(b2)dpx solid #ffd479;
            border-radius: %(r10)dpx; padding: %(p8)dpx %(p8)dpx; }
#keysel   { color: #0d1016; font-size: %(f17)dpt;
            background-color: #7fd4ff;
            border: %(b2)dpx solid #7fd4ff;
            border-radius: %(r10)dpx; padding: %(p8)dpx %(p8)dpx; }
#cell     { padding: %(p8)dpx %(p20)dpx; }
#cellsel  { background-color: #7fd4ff; border-radius: %(r10)dpx;
            padding: %(p8)dpx %(p20)dpx; }
#value    { color: #ffd479; font-size: %(f26)dpt; font-weight: bold; }
#valuesel { color: #0d1016; font-size: %(f26)dpt; font-weight: bold; }
#hint     { color: #8a94a0; font-size: %(f17)dpt; }
#count    { color: #ffd479; font-size: %(f30)dpt; font-weight: bold; }
""" % {
        "f34": pt(34), "f30": pt(30), "f26": pt(26), "f22": pt(22),
        "f21": pt(21), "f20": pt(20), "f17": pt(17), "f16": pt(16),
        "f14": pt(14),
        "b2": px(2), "b3": px(3), "r10": px(10), "r14": px(14), "r22": px(22),
        "p8": px(8), "p14": px(14), "p20": px(20), "p28": px(28),
        "p34": px(34), "p56": px(56),
    }).encode()


CSS = build_css(1.0)


def _screen_area(win):
    """Working area of the monitor the overlay is on. Gdk.Screen.get_width is
    deprecated and reports the whole X screen, which is wrong on multi-head."""
    display = Gdk.Display.get_default()
    monitor = (display.get_monitor_at_window(win.get_window())
               if win.get_window() else display.get_monitor(0))
    return monitor.get_geometry()


_css_scale = None
_css_provider = None


def ui_scale():
    """How much to shrink the interface for the current screen.

    A game that reduces the framebuffer reduces the X screen with it, and the
    overlay has to come down to match or it simply will not fit.
    """
    try:
        display = Gdk.Display.get_default()
        width = display.get_monitor(0).get_geometry().width
    except Exception:
        return 1.0
    if not width:
        return 1.0
    return max(0.35, min(1.6, width / DESIGN_WIDTH))


def install_css(scale=None):
    """(Re)register the stylesheet for the current screen size.

    Without a provider the widget names are set but nothing is styled, and the
    panel renders as bare text over the game with no card behind it. The scale
    is rechecked on every window build because a game can change the screen
    resolution while the HUD is already running.
    """
    global _css_scale, _css_provider
    scale = ui_scale() if scale is None else scale
    if _css_scale is not None and abs(scale - _css_scale) < 0.01:
        return
    screen = Gdk.Screen.get_default()
    if _css_provider is not None:
        Gtk.StyleContext.remove_provider_for_screen(screen, _css_provider)
    _css_provider = Gtk.CssProvider()
    _css_provider.load_from_data(build_css(scale))
    Gtk.StyleContext.add_provider_for_screen(
        screen, _css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    _css_scale = scale


def _overlay_window(name):
    # Rechecked every time: a game can change the screen resolution while the
    # HUD is already running, and rom2 does exactly that.
    install_css()
    win = Gtk.Window(type=Gtk.WindowType.POPUP)
    win.set_app_paintable(True)
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_accept_focus(False)      # never take focus away from the game
    win.set_focus_on_map(False)
    win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
    screen = win.get_screen()
    visual = screen.get_rgba_visual()
    if visual:
        win.set_visual(visual)
    return win


class Toast(object):
    """Brief message near the top of the screen."""

    def __init__(self):
        self.win = None
        self.timer = None

    def show(self, title, subtitle="", seconds=3.0):
        self.hide()
        self.win = _overlay_window("toast")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_name("toast")
        for pad in ("top", "bottom"):
            getattr(box, "set_margin_" + pad)(14)
        box.set_margin_start(26)
        box.set_margin_end(26)
        label = Gtk.Label(label=title)
        label.set_name("toasttitle")
        box.pack_start(label, True, True, 0)
        if subtitle:
            sub = Gtk.Label(label=subtitle)
            sub.set_name("toastsub")
            box.pack_start(sub, True, True, 0)
        self.win.add(box)
        self.win.show_all()
        width, height = self.win.get_size()
        area = _screen_area(self.win)
        # Bottom right: out of the way of anything the player is aiming at,
        # and clear of the d-pad/ammo readouts most of these games put bottom
        # left. TOAST_MARGIN keeps it off a TV's overscan edge.
        self.win.move(area.x + area.width - width - TOAST_MARGIN,
                      area.y + area.height - height - TOAST_MARGIN)
        self.timer = GLib.timeout_add(int(seconds * 1000), self._expire)

    def _expire(self):
        self.hide()
        return False

    def hide(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        if self.win:
            self.win.destroy()
            self.win = None


