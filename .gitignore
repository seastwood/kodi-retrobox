__pycache__/
*.pyc

# This machine's own state and secrets. Captured by install/capture.sh, carried
# by the backup, never published: it is one person's game library, settings and
# credentials, and the point of this repository is that anyone can start from
# it.
secrets/
state/
local/
backup/backup.conf

# Snapshots of what happens to be installed here now go to local/, so nothing
# under system/ needs ignoring. Leaving those rules here once silently dropped
# system/kodi-addons.txt -- a curated list that shares a name with an old
# capture -- out of the published repository.
